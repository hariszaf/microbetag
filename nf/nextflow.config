def getHPCBinds() {
    // Automatically detects and binds common HPC directories (scratch spaces, tmp, cache) into Singularity containers, 
    // making the binding portable across different HPC systems without hardcoded paths. More specificially, it: 
    //     binds standard temp directories (/tmp, /var/tmp) and the home cache directory if it exists
    //     detects and binds common HPC scratch spaces (/scratch, /lustre, /work, etc.)
    //     uses TMPDIR environment variable (common on HPC systems)
    //     creates portable bind mounts for any HPC environment

    def binds = ['--bind /tmp:/tmp', '--bind /var/tmp:/var/tmp']
    def home = System.getenv('HOME')
    
    // Bind home cache if it exists
    if (home && new File("${home}/.cache").exists()) {
        binds.add("--bind ${home}/.cache:${home}/.cache")
    }
    
    // Bind common HPC scratch spaces
    def scratchPaths = ['/scratch', '/lustre', '/work', '/gpfs/scratch']
    scratchPaths.each { path ->
        if (new File(path).exists()) {
            binds.add("--bind ${path}:${path}")
        }
    }
    
    // Bind TMPDIR if set (common on HPC)
    def tmpdir = System.getenv('TMPDIR')
    if (tmpdir && new File(tmpdir).exists()) {
        binds.add("--bind ${tmpdir}:${tmpdir}")
    }
    
    return binds.join(' ')
}


docker.enabled    = true
apptainer.enabled = false
singularity {
    enabled    = false
    autoMounts = true
    cacheDir   = "${HOME}/.singularity/images"
    runOptions = getHPCBinds()
}
//runOptions = '--bind /home/luna.kuleuven.be/u0156635/.cache/cobrapy:/home/luna.kuleuven.be/u0156635/.cache/cobrapy'

params {
    genomes = null
    faa_dir = null    
    recon_files = params.faa_dir ?: params.genomes  // Set recon_files based on hierarchy
}
