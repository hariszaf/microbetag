{"yaml": {"abundance_table_file": {"file_path": "input_files/abd_table.tsv", "description": "file_path of the abundance table file. The taxonomy scheme in this case is irrelevant. However, you need to make sure that the sequence identifiers used in this table, are the same with those in your network (if one provided) as well as with those in your bins/faa/xml files, again if such provdied.", "required": true, "examples": ["thirty_Samples.tsv", "counts_genomes_taxonomies.tsv"], "type": "string"}, "bins_fasta": {"dir_path": "input_files/my_bins", "description": "Name of the folder with the bins .fasta files.", "required": false, "type": "string"}, "output_directory": {"dir_path": "mtg_complete_output", "description": "Name of the output folder that will be built inside the io_path directory.", "required": true, "type": "string"}, "orfs": {"dir_path": null, "description": "In case Operating Reading Frames (ORFs) have been already computed (e.g., using Prodigal), you may provide the path to the folder with the .fna files.", "required": false, "type": "Path"}, "edge_list": {"file_path": null, "description": "If co-occurrence network already available, please provide its edge list; a 2 column tab separated file.", "required": false, "examples": ["edgelist.csv"], "type": "string"}, "sequence_id_taxonomy_map": {"file_path": null, "description": "A file\n", "required": {"value": false, "when": null}, "examples": [null], "type": "string"}, "threads": {"value": 2, "description": "Number of CPUs to be used.", "type": "integer"}, "precalulations_only": {"value": false, "description": "If true, only the precalculations will be performed. This means that neither an abundance table is nor an already available network will be considered, only the list of bins/MAGs; provided in the bins_fasta parameter. In case this is true, microbetag will make sure all the precalculations related to the annotations steps asked are available; if some are not, it will perform them. Once all precalculations required are available, it will then annotate the network.", "required": true, "type": "bool"}, "pathway_complementarity": {"value": true, "description": "Set whether pathway complementarities should be calcuated and then used to annotated the edges of the co-occurrence network.", "required": true, "type": "bool"}, "max_length_for_complement_from_scratch": {"value": 3, "description": "There are cases where a species has no KO related with a module but may get a complete alternative from the donor species. However, there are cases where a KEGG module consists of just 1-2 terms and other where dozins of KOs are required. Set the max length of a module that can be exchanged when no module related KO is present in the beneficiary in the first place.", "required": false, "type": "integer"}, "pathway_complement_percentage": {"value": 0.35, "description": "Per centage of the module (i.e., number of KO terms) up to which a potential donor may provide a beneficiary with. For example, if a module consists of 5 KOs and the beneficiary can share 4 missing from the donor, this is rather unlikely to happen. If no value is given all complementes will be returned.", "required": false, "type": "float"}, "ko_merged_file": {"file_path": null, "description": "A merged 3-column file with bins, contigs and the annotated KO term for all your genomes/bins. Needs to have a header and keep this order. You may have this from a previous microbetag run, or from annotations outside the microbetag software. Here is a example: bin_id\t            contig_id\t                                                KO D300418:bin_000001\tD300418:bin_000001_D300418:bin_000001@contig_00001691_10\tK07258 D300418:bin_000001\tD300418:bin_000001_D300418:bin_000001@contig_00001691_13\tK06024 ", "required": false, "type": "Path"}, "kofam_database": {"dir_path": "../../ext_data/kofam_database/", "description": "After downloading KOfam database from ftp://ftp.genome.jp/pub/db/kofam/ and decompress it. You will get profile HMMs in profiles/ directory and a ko_list file.\nu0156635@gbw-l-l0074:kofam_database$ ls ko_list  profiles\nProvide the path to the kofam directory_database directory.", "type": "Path"}, "seed_complementarity": {"value": true, "description": "This is the most time-consuming and challengint step of the workflow. You may perform microbetag with or without it by setting \\ this argument as true or false correspondinly.", "required": true, "type": "bool"}, "input_type_for_seed_complementarities": {"value": "bins_fasta", "value_from": ["bins_fasta", "coding_regions", "proteins_faa", "models"], "description": "Clarifies what is the information the input files to be used for the GEMs reconstruction include. This parameter is strongly related to the `sequence_files_for_reconstructions` as it is the last that specifies the path to the files described here. If GEMs are already available, then you may set the `input_type_for_seed_complementarities` as `models` and provide the path to the .xml models through the `sequence_files_for_reconstructions` parameter. If you intend to use ModelSEEDpy to reconstruct GEMs but you have already RAST annotated your genomes, i.e. gto, gto_2 and their corresponding .faa files are available, then you may set this parameter as `proteins_faa` and give the directory path to the .faa files in the `sequence_files_for_reconstructions`. If none of the above is available, then set this parameter as bins_fasta and leave the sequence_files_for_reconstructions blank.", "type": "string", "required": true}, "prev_calc_seed_sets": {"dir_path": null, "required": false, "description": "Path to directory with SeedSetDic.json and nonSeedSetDic.json files if previously calculated for the genomes under study Leave empty if no previously calculated dictionaries.\n", "type": "string"}, "prev_conf": {"file_path": null, "description": "", "required": null, "type": null}, "prev_nonseeds": {"file_path": null, "description": "", "required": null, "type": null}, "sequence_files_for_reconstructions": {"dir_path": null, "required": {"value": true, "when": "if input_type_for_seed_complementarities != \"bins_fasta\". Could be either .fna or .faa files."}, "description": null, "type": "string"}, "gene_predictor": {"value": "fragGeneScan", "value_from": ["fragGeneScan", "prodigal", "RAST"], "required": {"value": false, "when": "orfs_per_bin is None"}, "description": "RAST annotation is required/strongly suggested* if modelseedpy is going to be used as genre_reconstruction_with. Otherwise, the user may choose among fragGeneScan or prodigal; in the latter, the .faa returned by DiTing will be used.", "type": "string"}, "genre_reconstruction_with": {"value": "carveme", "value_from": ["modelseedpy", "carveme"], "required": {"value": true, "when": "seed_complementarity == true"}}, "gapfill_model": {"value": true, "description": "If true, modelseedpy will gapfill the reconstruction.", "type": "bool"}, "gapfill_media": {"value": true, "description": "If true, modelseedpy will", "type": "bool"}, "min_proba": {"value": 0.6, "description": "Minimum confidence that a prediction needs to have for keeping the the presence/absence finding.", "type": "float"}, "network_clustering": {"value": true, "description": null, "type": "bool", "required": false}, "prev_clustered_network": {"file_path": null, "description": "In case you have performed manta already in a previous run of microbetag or as a stand-alone tool,  you may provide directly its findings in CYJS format. Attention! When microbetag is about to actually run the manta step, it will first build a basenet.cyjs  that will then use for manta as its input. Please, make sure you provide the manta.cyjs and and not this basenet cyjs. \n", "type": "string", "required": false, "example": ["microbetag/ext_data/input_data/manta.cyjs", "microbetag_run_carve/plaque_manta_net.cyjs"]}, "metadata_file": {"file_path": null, "description": null, "type": null, "required": false}, "flashweave_args": {"het