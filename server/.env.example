# Settings of the web service. Copy to .env.dev (docker-compose.yml reads it) and fill in.
# Never commit the real file: .env* files are ignored, except this example.

# Flask session key: a long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# microbetagDB connection; the same user, password and database as in services/db/.env
USER_NAME=
PASSWORD=
HOST=db
PORT=3306
DB_NAME=

# How the taxa of an abundance table are matched to the genomes of the database:
#   species  (default) a public server, whose users come with any taxonomy (GTDB, SILVA, prep): each taxon's species
#            name is matched, exactly or nearly, to a GTDB species
#   lineage  a server of your own genomes (pipeline precalc + microbetag-export-db), whose tables name taxa as the
#            catalogue does: each taxon gets the genomes sharing its deepest rank, down to LINEAGE_MIN_RANK (genus by
#            default)
# Everything else, seed sets included, is in the database.
TAXON_MATCHING=
LINEAGE_MIN_RANK=
