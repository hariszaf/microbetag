# Settings of the web service. Copy to .env.dev (docker-compose.yml reads it) and fill in.
# Never commit the real file: .env* files are ignored, except this example.

# Flask session key: a long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# microbetagDB connection; the same user, password and database as in services/db/.env
USER_NAME=
PASSWORD=
HOST=db
PORT=3306
DB_NAME=

# The database's genomes. Leave empty for the GTDB database; for a database of your own genomes
# (pipeline precalc + microbetag-export-db): CATALOGUE=custom, SEEDS_DIR=/seeds (services/db/data, mounted
# by docker-compose.yml), and optionally CATALOGUE_MIN_RANK (genus by default).
CATALOGUE=
SEEDS_DIR=
